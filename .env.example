GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key

# Model Gemini untuk generate PRD (opsional).
GEMINI_MODEL=gemini-3.5-flash-lite

# Model Gemini untuk transkrip audio MoM (opsional).
# Default mengikuti GEMINI_MODEL; jika 404, otomatis mencoba
# gemini-2.5-flash lalu gemini-2.0-flash.
TRANSCRIBE_GEMINI_MODEL=gemini-3.5-flash-lite
